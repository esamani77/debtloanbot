generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  telegramId   String?        @unique
  googleId     String?        @unique
  username     String?        @unique
  name         String
  email        String?        @unique
  phone        String?        @unique
  passwordHash String?
  emailVerified Boolean       @default(false)
  phoneVerified Boolean       @default(false)
  nickname     String?
  language     Language       @default(EN)
  theme        Theme          @default(SYSTEM)
  createdAt    DateTime       @default(now())
  relationshipsA Relationship[] @relation("UserA")
  relationshipsB Relationship[] @relation("UserB")
  transactions Transaction[]  @relation("CreatedBy")
  bankAccounts BankAccount[]
  splitSessions SplitSession[]
  recurringTransactions RecurringTransaction[] @relation("RecurringCreatedBy")
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  sessions     Session[]
  connectTokens TelegramConnectToken[]
}

model OtpCode {
  id        String   @id @default(cuid())
  target    String
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([target, type])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model TelegramConnectToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  cardNumber    String
  accountNumber String
  bankName      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Relationship {
  id           String         @id @default(cuid())
  userA        User           @relation("UserA", fields: [userAId], references: [id])
  userAId      String
  userB        User           @relation("UserB", fields: [userBId], references: [id])
  userBId      String
  currency     Currency       @default(USD)
  createdAt    DateTime       @default(now())
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  @@unique([userAId, userBId])
}

model Transaction {
  id             String       @id @default(cuid())
  relationship   Relationship @relation(fields: [relationshipId], references: [id])
  relationshipId String
  amount         Float
  type           TransactionType
  createdBy      User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdById    String
  note           String?
  isSettled      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])
  expense        Expense?
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  name      String
  icon      String
  color     String
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  title         String
  amount        Float
  currency      Currency
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  note          String?
  date          DateTime        @default(now())
  transactionId String?         @unique
  transaction   Transaction?    @relation(fields: [transactionId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model RecurringTransaction {
  id             String              @id @default(cuid())
  relationship   Relationship        @relation(fields: [relationshipId], references: [id])
  relationshipId String
  createdBy      User                @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  createdById    String
  amount         Float
  type           TransactionType
  note           String?
  interval       RecurringInterval
  nextDueAt      DateTime
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  transactions   Transaction[]
}

model SplitSession {
  id           String      @id @default(cuid())
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  name         String?
  currency     Currency    @default(USD)
  status       SplitStatus @default(DRAFT)
  participants          String[]
  participantTelegramIds String[]
  joinedUserIds         String[]  @default([])
  shareToken   String?     @unique
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  bills        BillItem[]
  participantInvites SplitParticipantInvite[]
}

model SplitParticipantInvite {
  token            String       @id
  splitSessionId   String
  splitSession     SplitSession @relation(fields: [splitSessionId], references: [id], onDelete: Cascade)
  participantIndex Int
  claimedByUserId  String?
  claimedAt        DateTime?
  createdAt        DateTime     @default(now())
}

model BillItem {
  id          String       @id @default(cuid())
  sessionId   String
  session     SplitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  totalAmount Float
  paidByIndex Int
  splitType   SplitType
  shares      Float[]
  createdAt   DateTime     @default(now())
}

enum TransactionType {
  DEBT
  LOAN
}

enum Currency {
  USD
  EUR
  GBP
  IRT
  TRY
}

enum Language {
  EN
  FA
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum SplitStatus {
  DRAFT
  CALCULATED
  SHARED
}

enum SplitType {
  EQUAL
  PERCENTAGE
  CUSTOM
}

enum RecurringInterval {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum OtpType {
  EMAIL_REGISTRATION
  PHONE_REGISTRATION
  EMAIL_CONNECT
  PHONE_CONNECT
}

model PendingInvite {
  telegramId String   @id
  payload    String
  createdAt  DateTime @default(now())
}
