# ─── Database ──────────────────────────────────────────────────────────────────
# Pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://user:password@host:5432/debtmate?sslmode=require"
# Direct connection (used by Prisma migrations — can be the same as DATABASE_URL for self-hosted)
DIRECT_URL="postgresql://user:password@host:5432/debtmate"

# ─── Telegram Bot ──────────────────────────────────────────────────────────────
BOT_TOKEN="token from @BotFather"
BOT_USERNAME="your_bot_username"
# Production only — omit in development (long polling is used instead)
WEBHOOK_URL="https://your-server.com"
# Comma-separated channel handles users must join before using the bot (leave empty to disable)
REQUIRED_CHANNELS="@your_first_channel,@your_second_channel"

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="https://v0-debtmate-app.vercel.app"

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# ─── Google OAuth ───────────────────────────────────────────────────────────────
# Client ID from Google Cloud Console (used to verify ID tokens sent by the frontend)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── Email ─────────────────────────────────────────────────────────────────────
# Active driver: "mailtrap" | "brevo" | "resend" | omit for console log (dev)
MAIL_DRIVER="mailtrap"

# Mailtrap (https://mailtrap.io — use Email Testing inbox token for dev, Email Sending token for prod)
MAILTRAP_TOKEN="your-mailtrap-api-token"
MAILTRAP_FROM_EMAIL="hello@debtmate.app"
MAILTRAP_FROM_NAME="DebtMate"

# Brevo transactional REST API (https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY="xkeysib-..."           # API key (xkeysib-, not the xsmtpsib- SMTP key)
BREVO_FROM_EMAIL="no-reply@debtmate.ir"
BREVO_FROM_NAME="DebtMate"

# Resend (https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="DebtMate <noreply@debtmate.app>"

# ─── SMS ──────────────────────────────────────────────────────────────────────
# Active driver: "sms-ir" | "kavenegar" | "twilio" | omit for console log (dev)
SMS_DRIVER="sms-ir"

# SMS.ir (https://app.sms.ir — generate key from Developers section in panel)
SMS_IR_API_KEY="your-sms-ir-api-key"
SMS_IR_TEMPLATE_ID=12345           # numeric template ID configured in SMS.ir panel

# Kavenegar (https://panel.kavenegar.com)
KAVENEGAR_API_KEY="your-kavenegar-api-key"
KAVENEGAR_TEMPLATE="registerverify"   # template name configured in panel

# Twilio (fallback / international)
TWILIO_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TOKEN="your-twilio-auth-token"
TWILIO_FROM="+15551234567"

# ─── Scheduler ─────────────────────────────────────────────────────────────────
# Cron for debt reminders (default: every hour)
REMINDER_CRON="0 * * * *"
# Cron for recurring transactions (default: 08:00 daily)
RECURRING_CRON="0 8 * * *"

# ─── Google reCAPTCHA ──────────────────────────────────────────────────────────
# Set to "true" to enforce CAPTCHA on login, register, and OTP send endpoints
RECAPTCHA_ENABLED=false
# Server-side secret key from https://www.google.com/recaptcha/admin (use v3 keys)
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"
# Minimum v3 score to accept (0.0 = all pass, 1.0 = only certain humans; default 0.5)
RECAPTCHA_MIN_SCORE=0.5

# ─── Push Notifications (Web Push / VAPID) ─────────────────────────────────────
# Generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:noreply@debtmate.app"
# URL users are sent to when they tap a push notification
APP_URL="https://debtmate.ir"

# ─── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=""
